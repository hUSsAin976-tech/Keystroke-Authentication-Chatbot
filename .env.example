# Gemini API key — optional, for friendly verification messages
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Multi-user LSTM checkpoint (produced by train.py)
MULTIUSER_MODEL_PATH=model_multiuser.pt
MULTIUSER_META_PATH=model_multiuser_meta.json

# LSTM unknown-rejection gate (max softmax below this → unknown)
UNKNOWN_REJECTION_THRESHOLD=0.50

# Keystroke events per evaluated rolling window
WINDOW_SIZE=40
